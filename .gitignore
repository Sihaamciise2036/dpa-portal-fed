# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist
/build

# misc
.DS_Store
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# stray dependency-tree backups (these break Vite's dep scanner if scanned)
/node_modules.*

# vite
.vite
vite.config.js.timestamp-*

# Backend secrets and local runtime artifacts
/server/.env
/server/.env.*
!/server/.env*.example
/server/node_modules/
/server/.mail/
/.dev-server*.log
/.api-server*.log
/.dev-logs/
/.portal-check.png
/.backend-check.png

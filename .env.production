# Vite production build config, read at build time (not by the browser at
# runtime). Committed: these are reachable URLs, not secrets — server/.env.production
# is the file that holds credentials, and it stays untracked.
#
# REACT_APP_API_BASE_URL is left unset on purpose: with no value, ApiConstant.jsx
# falls back to "/api", same-origin — correct here because the frontend and the
# Express API are one Vercel project (api/index.js under the same domain).
REACT_APP_APP_ENV=production

# Where "Back to eCitizen" sends a citizen who arrived through eCitizen's SSO.
# See src/lib/ecitizenReturn.js — unset this and the action just does not appear.
REACT_APP_ECITIZEN_RETURN_URL=https://e-citizen-api.vercel.app/dashboard

# Production environment for the DPA API.
#
# This is a TEMPLATE — it is committed, so it holds no real values. Paste the
# filled-in versions into your host's environment variable UI (Render, Railway,
# Fly.io, ...). Do not commit the filled-in file.

# From Atlas -> Connect -> Drivers -> Node.js. URL-encode special characters in
# the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=dpa_portal

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT value from development: changing it signs every session out,
# and a leaked development secret must never be able to mint production tokens.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# How long the driver hunts for a reachable node before failing. Lower than the
# 12000 default so an unreachable cluster fails fast and legibly instead of
# hanging past the host's own gateway timeout.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000

PORT=3005
# Hosted platforms route to the container, so bind all interfaces rather than
# loopback. On 127.0.0.1 the platform's health check cannot reach the process.
HOST=0.0.0.0

# The deployed frontend's origin. No wildcard: the API is called with a bearer
# token, and a wildcard would let any site drive it with a user's credentials.
CLIENT_ORIGINS=https://your-portal.vercel.app

NODE_ENV=production

# REQUIRED in production — startup fails without SMTP_HOST, because there is no
# outbox to fall back on and users could never receive a verification code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DPA Portal <noreply@example.com>

# How long to wait for the mail transport before giving up and clearing the
# pending challenge. Must stay below the platform's function timeout (30s on
# Vercel): a killed invocation runs no cleanup, so the challenge survives and
# the one-minute cooldown then refuses the user's retry for a code that was
# never sent.
MAIL_TIMEOUT_MS=12000

# Number of reverse proxies in front of the API. Defaults to 1 when
# NODE_ENV=production, which is correct for Vercel — leave it unless you have
# put something else in front. Without it Express reads the proxy's own address
# as every visitor's IP and the auth rate limiter puts the whole site in one
# 40-request bucket. Never "true": that trusts a client-supplied
# X-Forwarded-For and lets anyone spoof past the limiter.
TRUST_PROXY=1

# Federated sign-in from eCitizen (optional). Must match
# DPA_INTEGRATION_CLIENT_SECRET on the eCitizen API exactly, minimum 32
# characters, never given to a browser. Leave unset and the integration routes
# answer 503 while the rest of the portal is unaffected.
# ECITIZEN_CLIENT_ID=ecitizen
# ECITIZEN_CLIENT_SECRET=replace-with-a-shared-secret-of-at-least-32-characters
# PORTAL_BASE_URL=https://your-portal.vercel.app

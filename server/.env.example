MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=dpa_portal
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3005
HOST=127.0.0.1
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
# Without SMTP, development verification messages are saved in server/.mail.
# Production startup requires SMTP_HOST.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=DPA Portal <noreply@example.com>

# Federated sign-in from eCitizen (optional).
#
# Leave both unset and /api/integration/ecitizen/* answers 503 — there is no
# unsigned fallback, because accepting an unsigned request would let anyone who
# can reach this API open a session as any citizen. The secret must match
# DPA_INTEGRATION_CLIENT_SECRET on the eCitizen API, must be at least 32
# characters, and must never be given to a browser. PORTAL_BASE_URL is where
# this portal is served; the launch URL is composed against it, because DPA owns
# its own routes and eCitizen never builds one. Defaults to the first
# CLIENT_ORIGINS entry.
# ECITIZEN_CLIENT_ID=ecitizen
# ECITIZEN_CLIENT_SECRET=replace-with-a-shared-secret-of-at-least-32-characters
# PORTAL_BASE_URL=http://localhost:3000
